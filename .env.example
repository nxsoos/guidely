OPENAI_CHAT_MODEL=gpt-4.1-mini
GUIDELY_DATA_DIR=runtime
GUIDELY_MIN_SIMILARITY=0.25
# fake is for automated tests and offline workflow demos, not real AI answers.
GUIDELY_COOKIE_SECURE=false

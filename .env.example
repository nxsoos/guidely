# BACKEND ONLY. Copy to root .env for local development. Never commit real values.
# Use these names in Vercel Project Settings > Environment Variables.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_WITH_URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=guidely-documents
GUIDELY_PROVIDER=gemini
# Keep using your existing Gemini key from your private local .env.
GEMINI_API_KEY=REPLACE_WITH_EXISTING_GEMINI_KEY
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GUIDELY_MIN_SIMILARITY=0.25
# true on HTTPS production; Vercel enforces Secure cookies automatically.
GUIDELY_COOKIE_SECURE=false
# Test-only local adapters. NEVER enable on Vercel.
GUIDELY_TEST_MODE=false
# Used only by test adapters, not production persistence.
GUIDELY_DATA_DIR=runtime

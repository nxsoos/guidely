GUIDELY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# Optional: set GUIDELY_PROVIDER=openai to use these settings instead.
OPENAI_API_KEY=
